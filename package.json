{
  "name": "responsive-snap",
  "version": "2.0.0",
  "description": "This is a figma plugin that help figma user to get the screenshot of a website with different device size.",
  "license": "MIT",
  "author": "Kevin Shiuan",
  "main": "code.js",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "pnpm run build:ui && esbuild src/plugin/code.ts --bundle --outfile=dist/code.js --minify",
    "build:main": "esbuild src/plugin/code.ts --bundle --outfile=dist/code.js",
    "build:main:watch": "esbuild src/plugin/code.ts --bundle --outfile=dist/code.js --watch",
    "build:ui": "pnpm exec vite build --minify esbuild --emptyOutDir=false",
    "build:ui:watch": "pnpm exec vite build --minify esbuild --emptyOutDir=false --watch",
    "build:watch": "concurrently -n widget,iframe \"pnpm run build:main:watch\" \"pnpm run build:ui:watch\"",
    "dev": "concurrently -n tsc,build,vite 'pnpm:tsc:watch' 'pnpm:build:watch' 'vite'",
    "prettier-write": "prettier . --write ./src/**/*",
    "tsc": "pnpm run tsc:main && pnpm run tsc:ui",
    "tsc:main": "tsc --noEmit -p src/plugin",
    "tsc:main:watch": "tsc --noEmit -p src/plugin --watch --preserveWatchOutput",
    "tsc:ui": "tsc --noEmit -p src/ui",
    "tsc:ui:watch": "tsc --noEmit -p src/ui --watch --preserveWatchOutput",
    "tsc:watch": "concurrently -n widget,iframe \"pnpm run tsc:main:watch\" \"pnpm run tsc:ui:watch\""
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@figma/plugin-typings": "*",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "eslint": "8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.0.11",
    "lint-staged": "^17.0.7",
    "postcss": "^8.4.38",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-svgr": "^5.2.0"
  }
}
